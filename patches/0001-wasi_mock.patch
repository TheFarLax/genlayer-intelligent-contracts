+def _json_text(value: Any) -> str:
+    """Render a mock response as JSON text when calldata cannot carry it.
+
+    Floats are the common case: calldata has no float encoding, yet LLM
+    replies commonly contain them.
+    """
+    import json
+
+    def _default(obj: Any) -> Any:
+        if isinstance(obj, (bytes, bytearray)):
+            return obj.decode("utf-8", "replace")
+        return str(obj)
+
+    return json.dumps(value, default=_default)
+
