+def _self_patch_fdopen() -> None:
+    """Route the stdlib's own os.fdopen through patched_fdopen.
+
+    unittest.mock.patch('os.fdopen', ...) swaps the attribute on the module,
+    but the C-level `os` module object that `import os` hands out is the same
+    one the interpreter shares, so a later `fake_open` in fakes.py (which does
+    `from genlayer.py.types import ...; os.fdopen = ...` style rebinding) can
+    silently restore the real one. Rebinding here makes the interception
+    durable for the whole session.
